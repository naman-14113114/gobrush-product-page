{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "rewrites": [
    {"source":"/policies/privacy-policy","destination":"/privacy.html"},
    {"source":"/policies/return-policy","destination":"/return-policy.html"},
    {"source":"/policies/shipping-policy","destination":"/shipping-policy.html"},
    {"source":"/policies/refund-policy","destination":"/refund-policy.html"},
    {"source":"/policies/terms-of-service","destination":"/terms.html"},
    {"source":"/policies/cookies-policy","destination":"/cookies-policy.html"},
    {"source":"/pages/order-tracking","destination":"/order-tracking.html"},
    {"source":"/pages/contact-us","destination":"/contact.html"},
    {"source":"/about","destination":"/about-us.html"},
    {"source":"/about-us","destination":"/about-us.html"}
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(?i)^(VN|HK|CN|SG|US)$"
        }
      ],
      "destination": "https://miroooo.us",
      "permanent": false
    },
    {"source":"/miroooo-x","destination":"/products/miroooo-x","permanent":true},
    {"source":"/miroooo-x2","destination":"/products/miroooo-x2","permanent":true}
  ],
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/(.*)\\.(jpg|jpeg|png|webp|svg|woff2)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}
  ]
}
